# SQL Server (local)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=sa
DB_PASSWORD=your_password
# Or leave DB_USER/DB_PASSWORD blank to use Windows/Trusted connection

# Feishu app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Feishu Base (多维表格) target
# 多维表格 App Token：浏览器打开多维表格时，URL 中 /base/ 后面的那串，以 bascn 开头
FEISHU_BASE_APP_TOKEN=bascnXXXXXXXXXXXXXX
FEISHU_BASE_TABLE_ID=tblXXXXXXXXXXXXXX
# Optional: if you want to sync into a specific view
# FEISHU_BASE_VIEW_ID=vewXXXXXXXXXXXXXX
