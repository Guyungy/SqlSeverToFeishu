# SQL Server (local)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=sa
DB_PASSWORD=your_password
# Or leave DB_USER/DB_PASSWORD blank to use Windows/Trusted connection

# Feishu app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Feishu Base (多维表格) target
# 【推荐】只填这个多维表格完整链接，自动识别 app_token/table_id/view_id。
#   在飞书打开目标「多维表格」的某个数据表，复制浏览器地址栏整条链接，形如：
#   https://xxx.feishu.cn/base/BakJbd...?table=tblXXX&view=vewXXX
FEISHU_BASE_URL=
# 以下三个是「不填链接」时的备选，通常留空即可（填了链接会被自动覆盖）
FEISHU_BASE_APP_TOKEN=
FEISHU_BASE_TABLE_ID=
FEISHU_BASE_VIEW_ID=
