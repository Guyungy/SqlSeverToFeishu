# ============================================================
# 本文件是「可选参考」，不是必填。
#
# 所有配置都可以在网页界面里填写保存：
#   - 飞书 App ID / App Secret / 多维表格链接 → 界面「飞书空间」
#   - 数据库地址、端口、库名、账号密码        → 界面「数据源」
#   - 查询超时 / NULL 策略 / 时区 / 服务端口   → 界面「运行设置」
# 界面保存时会自动维护本文件（凭据类）与 sync_config.json（任务与设置），
# 正常情况下你不需要手动编辑这个文件。
#
# 只有以下几种情况才需要手工建 .env：
#   - 想在没有界面时直接用命令行跑 python sync.py
#   - 想把配置随项目一起分发，不想在每台机器重新填一遍
# ============================================================

# ---------- SQL Server（命令行模式使用；界面模式下请在「数据源」里配置）----------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=your_database_name
# 强烈建议使用仅有目标表/视图 SELECT 权限的专用账号，不要使用 sa
DB_USER=readonly_sync_user
DB_PASSWORD=your_password
DB_TABLE=dbo.Orders
# 查询超时（秒）。也对应界面「运行设置 → SQL 查询超时」
DB_QUERY_TIMEOUT=60
# Windows 集成认证是否可用取决于 pymssql/FreeTDS 环境；不确定时请使用只读 SQL 登录

# ---------- 同步行为（界面「运行设置」里改更直观）----------
# skip = SQL 侧为 NULL 时不覆盖飞书已有的值；overwrite = 把飞书字段清空
SYNC_NULL_POLICY=skip
# SQL 无时区日期按此小时偏移解释，中国标准时间填 8
SYNC_TIMEZONE_OFFSET=8
# 面板监听端口，留空则用界面设置或 5001
DASHBOARD_PORT=

# ---------- 飞书应用凭据（界面「飞书空间」里填写）----------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 飞书多维表格目标 ----------
# 【推荐】只填这个多维表格完整链接，自动识别 app_token/table_id/view_id。
#   在飞书打开目标「多维表格」的某个数据表，复制浏览器地址栏整条链接，形如：
#   https://xxx.feishu.cn/base/示例应用令牌?table=tbl示例表&view=vew示例视图
FEISHU_BASE_URL=
# 以下三个是「不填链接」时的备选，通常留空即可（填了链接会被自动覆盖）
FEISHU_BASE_APP_TOKEN=
FEISHU_BASE_TABLE_ID=
FEISHU_BASE_VIEW_ID=
