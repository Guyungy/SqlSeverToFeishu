#!/usr/bin/env bash
# ============================================================
# macOS 双击启动文件
# 双击本文件即可安装依赖 + 启动程序（无需打开终端）
# 首次双击如果被系统阻止：右键 → 打开 → 仍要打开
# ============================================================
cd "$(dirname "$0")"

echo "========================================="
echo "  首次运行会自动检查并安装依赖..."
echo "========================================="

# 确保依赖已安装
if [ ! -d ".venv" ]; then
    echo "尚未安装依赖，现在开始安装（请稍候）..."
    ./install.sh
    echo ""
    echo "依赖安装完成。"
fi

echo "启动面板: http://127.0.0.1:5001"
echo "（启动后请勿关闭此窗口）"
echo ""
DASHBOARD_PORT=5001 exec ./.venv/bin/python dashboard.py